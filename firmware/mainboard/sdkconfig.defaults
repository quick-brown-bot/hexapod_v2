# PlatformIO seeds the generated sdkconfig.<env> from this file.
# Keep only deliberate non-defaults here. The partition table is owned by
# platformio.ini (board_build.partitions), so it is intentionally NOT set here.

# Bluetooth Classic transport (shared V1 controller transport, inherited by V2).
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y

# 1 kHz scheduler tick so the 100 Hz locomotion loop can hold a 10 ms period
# with vTaskDelayUntil (at the default 100 Hz the minimum delay quantum is the
# whole 10 ms period, forcing the loop below its target rate). ESP32 CCOUNT
# systick supports up to 1000 Hz. NOTE: verify it stuck -- the gait task logs
# the effective configTICK_RATE_HZ at boot.
CONFIG_FREERTOS_HZ=1000
